@import url("unity-theme://default");

.unity-scroller { background-color: #192b36; width: 12px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider__tracker { background-color: #192b36; }
.unity-base-slider__dragger { background-color: #bc9558; border-radius: 5px; }
.unity-button:disabled { opacity: 0.45; }
